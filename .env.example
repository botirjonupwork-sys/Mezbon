# ─── Telegram botlar ───────────────────────────────────
# Asosiy (foydalanuvchi) bot
BOT_TOKEN=your_telegram_bot_token
# Kuryer bot
COURIER_BOT_TOKEN=your_courier_bot_token
# Catering bildirishnoma bot (ertangi kun zakazlari uchun)
CATERING_BOT_TOKEN=your_catering_bot_token

# WebApp va API
WEBAPP_URL=https://your-domain.com
API_URL=http://localhost:8086

# ─── Ma'lumotlar bazasi ────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./muhsina.db
# Yoki PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/muhsina

# ─── Kesh ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Alice POS ─────────────────────────────────────────
ALICE_API_URL=https://api.alicepos.com/v2
ALICE_API_KEY=your_alice_api_key
ALICE_STORE_ID=your_store_id

# ─── XAVFSIZLIK: ishlab chiqarishda MAJBURIY o'zgartiring ──
# SECRET_KEY — uzun va tasodifiy bo'lishi kerak (min 32 belgi)
# Generatsiya: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_PLUS_CHARS

# Kuchli parollar qo'ying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12_PLUS_CHARS
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=CHANGE_ME_VERY_STRONG_20_PLUS_CHARS

# ─── Rejim ─────────────────────────────────────────────
DEBUG=False

# ─── CORS (ixtiyoriy — qo'shimcha domen uchun) ────────
# CORS_EXTRA_ORIGINS=https://other-domain.com,https://app.example.com
